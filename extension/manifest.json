{
  "manifest_version": 3,
  "name": "HeaderWright — Modify HTTP Headers",
  "version": "0.2.0",
  "description": "Set and remove HTTP request and response headers by profile; append on request only. No webRequest — it cannot read your traffic.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "HeaderWright",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/sw.js",
    "type": "module"
  },
  "minimum_chrome_version": "101",
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "storage"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ]
}
